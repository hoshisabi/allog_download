<Project Sdk="Microsoft.NET.Sdk">

  <!-- Command-line host over Allog.Core. Runs on Windows, macOS, and Linux; the executable is named `allog`. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>allog</AssemblyName>
    <RootNamespace>Allog.Cli</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Adventure League Log Downloader.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Allog.Core\Allog.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.14" />
  </ItemGroup>

</Project>
